# Copy to .env for LOCAL use only (never commit .env). On Render, set these in the dashboard instead.
GEMINI_API_KEY=
# Pick a model your key can use; run `npm run check:gemini` to list them. (gemini-2.5-* is restricted for new keys and answers HTTP 404.)
GEMINI_MODEL=gemini-3.5-flash-lite
MONGODB_URI=
SESSION_SECRET=
NODE_ENV=development
PORT=3000
# TRUST_PROXY=2
# DB_PATH=./gradguide.db
# GEMINI_BASE_URL=   # optional: override the API endpoint (used for local mocks)